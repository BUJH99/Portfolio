# master xdc for JFK-100A xilinx board
set_property IOSTANDARD LVCMOS33 [get_ports iClk]
set_property IOSTANDARD LVCMOS33 [get_ports iRstn]
set_property IOSTANDARD LVCMOS33 [get_ports {iKeyIn[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {iKeyIn[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {iKeyIn[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {iKeyIn[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {iKeyIn[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oKeyOut[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oKeyOut[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oKeyOut[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oKeyOut[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oSegCom[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oSegCom[6]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oSegCom[5]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oSegCom[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oSegCom[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oSegCom[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oSegCom[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oSegCom[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oSegData[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oSegData[6]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oSegData[5]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oSegData[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oSegData[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oSegData[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oSegData[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oSegData[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oIndex[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oIndex[6]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oIndex[5]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oIndex[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oIndex[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oIndex[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oIndex[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {oIndex[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports oFFT]
set_property IOSTANDARD LVCMOS33 [get_ports oReIm]

set_property PACKAGE_PIN D4 [get_ports iClk]
set_property PACKAGE_PIN H13 [get_ports iRstn]
set_property PACKAGE_PIN D8 [get_ports {oSegCom[7]}]
set_property PACKAGE_PIN C8 [get_ports {oSegCom[6]}]
set_property PACKAGE_PIN H11 [get_ports {oSegCom[5]}]
set_property PACKAGE_PIN G11 [get_ports {oSegCom[4]}]
set_property PACKAGE_PIN A9 [get_ports {oSegCom[3]}]
set_property PACKAGE_PIN B9 [get_ports {oSegCom[2]}]
set_property PACKAGE_PIN A10 [get_ports {oSegCom[1]}]
set_property PACKAGE_PIN B10 [get_ports {oSegCom[0]}]
set_property PACKAGE_PIN D15 [get_ports {iKeyIn[4]}]
set_property PACKAGE_PIN C12 [get_ports {iKeyIn[3]}]
set_property PACKAGE_PIN D16 [get_ports {iKeyIn[2]}]
set_property PACKAGE_PIN G15 [get_ports {iKeyIn[1]}]
set_property PACKAGE_PIN E15 [get_ports {iKeyIn[0]}]
set_property PACKAGE_PIN D11 [get_ports {oKeyOut[3]}]
set_property PACKAGE_PIN E16 [get_ports {oKeyOut[2]}]
set_property PACKAGE_PIN G16 [get_ports {oKeyOut[1]}]
set_property PACKAGE_PIN D13 [get_ports {oKeyOut[0]}]
set_property PACKAGE_PIN A13 [get_ports {oSegData[7]}]
set_property PACKAGE_PIN B12 [get_ports {oSegData[6]}]
set_property PACKAGE_PIN A12 [get_ports {oSegData[5]}]
set_property PACKAGE_PIN B11 [get_ports {oSegData[4]}]
set_property PACKAGE_PIN B15 [get_ports {oSegData[3]}]
set_property PACKAGE_PIN A15 [get_ports {oSegData[2]}]
set_property PACKAGE_PIN B14 [get_ports {oSegData[1]}]
set_property PACKAGE_PIN A14 [get_ports {oSegData[0]}]
set_property PACKAGE_PIN D14 [get_ports {oIndex[0]}]
set_property PACKAGE_PIN C14 [get_ports {oIndex[1]}]
set_property PACKAGE_PIN E13 [get_ports {oIndex[2]}]
set_property PACKAGE_PIN E12 [get_ports {oIndex[3]}]
set_property PACKAGE_PIN F14 [get_ports {oIndex[4]}]
set_property PACKAGE_PIN F13 [get_ports {oIndex[5]}]
set_property PACKAGE_PIN G14 [get_ports {oIndex[6]}]
set_property PACKAGE_PIN G12 [get_ports {oIndex[7]}]
set_property PACKAGE_PIN C16 [get_ports oFFT]
set_property PACKAGE_PIN F15 [get_ports oReIm]

# 10 MHz system clock on iClk (pin D4)
create_clock -period 100.000 -name sys_clk -waveform {0.000 50.000} [get_ports iClk]

